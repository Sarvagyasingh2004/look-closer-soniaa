# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, defaults to "lookcloser")
MONGODB_DB=lookcloser

# Password for the private inbox at /inbox (any username works)
INBOX_PASSWORD=choose-a-long-password


SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-digit-password
# Optional: how the sender is shown
MAIL_FROM=Look Closer <youremail@gmail.com>
NOTIFY_EMAIL=youremail@gmail.com

# Your live URL, used for link previews when the page is shared (optional)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
